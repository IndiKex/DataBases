<jardesc>
    <jar path="DataBases/exports/DataBaseLib.jar"/>
    <options buildIfNeeded="true" compress="true" descriptionLocation="/DataBases/exports/DataBaseLib.jardesc" exportErrors="true" exportWarnings="true" includeDirectoryEntries="false" overwrite="false" saveDescription="true" storeRefactorings="false" useSourceFolders="false"/>
    <storedRefactorings deprecationInfo="true" structuralOnly="false"/>
    <selectedProjects/>
